{
  "name": "track-my-flights",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "description": "Track My Flights — a local, self-hosted flight logbook",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,cyan \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "seed": "tsx scripts/seed-airports.ts && tsx scripts/seed-airlines.ts",
    "seed:airports": "tsx scripts/seed-airports.ts",
    "seed:airlines": "tsx scripts/seed-airlines.ts",
    "verify": "tsx migration/verify.ts",
    "test": "tsx --test server/lib/*.test.ts migration/*.test.ts migration/lib/*.test.ts web/src/lib/*.test.ts",
    "i18n:check": "node scripts/i18n-check.mjs",
    "theme:check": "node scripts/theme-check.mjs",
    "import:json": "tsx migration/import-json.ts",
    "import:fr24": "tsx migration/import-fr24.ts",
    "publish:oss": "node scripts/publish-oss.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.7.0",
    "tz-lookup": "^6.1.25",
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "pretendard": "^1.3.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3-geo": "^3.1.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "better-sqlite3@12.11.1": true
  }
}
